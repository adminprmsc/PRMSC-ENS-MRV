<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Production uses HTTP until TLS is enabled on mrv.essprmsc.com (port 443). -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">mrv.essprmsc.com</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
